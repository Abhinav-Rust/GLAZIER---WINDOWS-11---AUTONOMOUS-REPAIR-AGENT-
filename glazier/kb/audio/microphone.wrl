adhikara diagnose_microphone {
  target: device(microphone)

  pratyaksha {
    observe: [
      driver_state(realtek_audio),
      driver_state(hd_audio_generic),
      service_state(AudioSrv),
      service_state(AudioEndpointBuilder),
      event_log(System, source: "audiodg"),
      device_manager_status(microphone)
    ]
    via: [device_manager, event_log, wmi]
  }

  vyapti post_update_driver_conflict {
    whenever: error_code(43) AND windows_updated(within: 72h)
    always:   cause(driver_version_incompatibility)
    witnessed: [case_seed_001]
    confidence: established
  }

  vyapti service_stopped_cause {
    whenever: service_state(AudioSrv) == stopped
    always:   cause(audio_service_not_running)
    witnessed: [case_seed_002]
    confidence: established
  }

  anumana primary_diagnosis {
    pratijnha:  microphone_not_functioning
    hetu:       error_code(43)
    udaharana:  post_update_driver_conflict
    upanaya:    current_system_matches_hetu
    nigamana:   attempt(rollback_driver(realtek_audio))
  }

  anumana service_diagnosis {
    pratijnha:  microphone_not_functioning
    hetu:       service_state(AudioSrv) == stopped
    udaharana:  service_stopped_cause
    upanaya:    current_system_matches_hetu
    nigamana:   attempt(restart_service(AudioSrv))
  }

  abhava realtek_driver {
    pragabhava:   -> fresh_install(realtek_audio)
    dhvamsabhava: -> reinstall(realtek_audio) | rollback_driver(realtek_audio)
    atyantabhava: -> install(hd_audio_generic)
    anyonyabhava: -> redirect(diagnose_audio_service)
  }

  virodha audio_bluetooth {
    improving: realtek_audio_driver
    degrades:  bluetooth_stack
    guna:      rajas
    upaya: [
      sama  -> test_compatibility_mode,
      dana  -> install_unified_audio_bt_driver,
      bheda -> isolate(audio_stack),
      danda -> force_uninstall(conflicting_component)
    ]
  }

  tarka hardware_fault {
    assume:          cause(hardware_fault)
    predict:         mic_fails_in_safe_mode
    test:            query_user("Does mic work in safe mode?")
    if_contradicted: reject(hardware_fault) -> pursue(software_cause)
    if_confirmed:    establish(hardware_fault) -> escalate("Physical repair needed. Software cannot resolve this.")
  }
}
